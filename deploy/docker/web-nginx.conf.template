# The nginx image entrypoint fills ${API_UPSTREAM}, ${POWERSYNC_URL} and
# ${POWERSYNC_WS_URL} from the environment and writes conf.d/default.conf.

map $uri $mt_cache_control {
    ~^/api/                "";
    ~^/(_expo|assets)/     "public, max-age=31536000, immutable";
    default                "no-cache";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;

    add_header Cache-Control $mt_cache_control always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${POWERSYNC_URL} ${POWERSYNC_WS_URL}; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # nginx sends the X-Real-IP of the request to the API without a change. The
    # edge proxy must set it (see docs/operations.md). The local e2e suite
    # sets it to give each browser its own login rate limit.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Run-time config for the app. Do not use add_header here: it drops the
    # server-level headers above.
    location = /config.json {
        default_type application/json;
        return 200 '{"powersyncUrl":"${POWERSYNC_URL}"}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
