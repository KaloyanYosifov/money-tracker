{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recurring_rule.schema.json",
  "title": "RecurringRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "type", "amount_minor", "name", "account_id", "frequency", "start_date"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "enum": ["expense", "income", "transfer"] },
    "amount_minor": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
    "name": { "type": "string", "minLength": 0, "maxLength": 120 },
    "category_id": { "type": ["string", "null"], "format": "uuid" },
    "account_id": { "type": "string", "format": "uuid" },
    "to_account_id": { "type": ["string", "null"], "format": "uuid" },
    "note": { "type": ["string", "null"], "minLength": 0, "maxLength": 2000 },
    "frequency": { "type": "string", "enum": ["daily", "weekly", "biweekly", "monthly", "yearly"] },
    "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "end_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
