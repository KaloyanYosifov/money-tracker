{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user_settings.schema.json",
  "title": "UserSettings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "user_id", "currency_code", "time_period", "week_start_day", "month_start_day",
    "year_start_month", "budget_mode", "carry_over", "hide_future", "show_note",
    "theme", "summary_font", "icon_style", "insights_enabled"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string", "format": "uuid" },
    "currency_code": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "time_period": { "type": "string", "enum": ["daily", "weekly", "biweekly", "monthly", "yearly"] },
    "week_start_day": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "0 is Sunday."
    },
    "month_start_day": { "type": "integer", "minimum": 1, "maximum": 28 },
    "year_start_month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "budget_mode": { "type": "boolean" },
    "carry_over": { "type": "boolean" },
    "hide_future": { "type": "boolean" },
    "show_note": { "type": "boolean" },
    "theme": { "type": "string", "enum": ["light", "dark", "system"] },
    "summary_font": { "type": "string", "enum": ["mono", "system"] },
    "icon_style": { "type": "string", "enum": ["filled", "outline"] },
    "insights_enabled": { "type": "boolean" }
  }
}
