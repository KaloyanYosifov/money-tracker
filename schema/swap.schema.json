{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swap.schema.json",
  "title": "Swap",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "from_instrument_id", "to_instrument_id", "date", "from_quantity", "to_quantity", "fee", "value", "to_value"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string", "format": "uuid" },
    "from_instrument_id": { "type": "string", "format": "uuid" },
    "to_instrument_id": { "type": "string", "format": "uuid" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "from_quantity": { "type": "string", "pattern": "^\\d{1,12}(\\.\\d{1,12})?$" },
    "to_quantity": { "type": "string", "pattern": "^\\d{1,12}(\\.\\d{1,12})?$" },
    "fee": { "type": "string", "pattern": "^\\d{1,12}(\\.\\d{1,12})?$" },
    "value": { "type": "string", "pattern": "^\\d{1,12}(\\.\\d{1,12})?$" },
    "to_value": { "type": "string", "pattern": "^\\d{1,12}(\\.\\d{1,12})?$" },
    "note": { "type": ["string", "null"], "minLength": 0, "maxLength": 200 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "description": "Set by the server."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "description": "Set by the server."
    }
  }
}
